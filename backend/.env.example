# =============================================================================
# Gotta-do-it API — Environment variables
# Copy to .env and fill in real values. Never commit .env to git.
# =============================================================================

# Server
NODE_ENV=development
PORT=5000

# -----------------------------------------------------------------------------
# MongoDB — choose ONE option
# -----------------------------------------------------------------------------

# Option A: Local MongoDB (default for development)
# MONGODB_URI=mongodb://127.0.0.1:27017/gotta-do-it

# Option B: MongoDB Atlas (cloud) — recommended for production & team dev
# Get this from Atlas → Database → Connect → Drivers → Node.js
# Replace USER, PASSWORD, and CLUSTER with your values:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gotta-do-it?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/gotta-do-it?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=gdi_token

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000
