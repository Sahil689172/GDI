{
  "name": "gotta-do-it",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run dev --prefix backend",
    "dev:all": "concurrently -n web,api -c cyan,green \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -n web,electron -c cyan,magenta \"npm run dev\" \"npm run desktop\"",
    "desktop:all": "concurrently -n api,web,electron -c green,cyan,magenta \"npm run dev:api\" \"npm run dev\" \"npm run desktop\"",
    "desktop": "wait-on http://localhost:3000 http-get://127.0.0.1:5000/api/health && electron .",
    "desktop:build": "npm run build && electron-builder",
    "icons:build": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.16.1",
    "date-fns": "^4.3.0",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.1.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.11",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.5"
  }
}
